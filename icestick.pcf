# iCEstick Pin Constraint File for ICE40HX1K
# Pin definitions for the iCEstick evaluation board

# 12 MHz clock
set_io CLK 21

# LEDs (active high)
set_io LED1 99
set_io LED2 98
set_io LED3 97
set_io LED4 96
set_io LED5 95

# UART TX (connect to FTDI RX)
# Using pin 8 (PIO1_02) which connects to FTDI RX
set_io UART_TX 8

# UART RX (connect to FTDI TX)
# Using pin 9 (PIO1_03) which connects to FTDI TX
set_io UART_RX 9

# NOTE: For UART communication using the built-in FTDI chip:
# - UART_TX (FPGA output) connects to RXD (pin 8)
# - UART_RX (FPGA input) connects to TXD (pin 9)
